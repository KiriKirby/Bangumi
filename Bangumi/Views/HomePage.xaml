<Page
    x:Class="Bangumi.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:bangumiControls="using:Bangumi.Controls"
    xmlns:common="using:Bangumi.Common"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:local="using:Bangumi.Views"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    Loaded="Page_Loaded"
    Background="Transparent">

    <Page.Resources>
        <x:Double x:Key="DiscoveryShortcutTitleFontSize">15</x:Double>
        <x:Double x:Key="DiscoveryShortcutDescriptionFontSize">12</x:Double>
        <x:Double x:Key="DiscoveryCardTitleFontSize">16</x:Double>
        <x:Double x:Key="DiscoveryCardBodyFontSize">12</x:Double>
        <x:Double x:Key="DiscoveryCollectionStatusFontSize">13</x:Double>

        <LinearGradientBrush x:Key="HomeStickyHeaderBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource ShellMainTopColor}" Offset="0"/>
            <GradientStop Color="{StaticResource ShellMainMidColor}" Offset="0.42"/>
            <GradientStop Color="{StaticResource ShellMainBottomColor}" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ShortcutItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeaturedItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource ShortcutItemStyle}"/>

        <Style x:Key="FlatActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E02A2329"/>
            <Setter Property="BorderBrush" Value="#52FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#F23B333A"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#7AFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF211B20"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#96FFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.94" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ShellPrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <DataTemplate x:Key="DiscoveryShortcutTemplate" x:DataType="local:HomeShortcutItem">
            <Button
                Style="{StaticResource FlatActionButtonStyle}"
                Width="{Binding ElementName=ShortcutGridView, Path=Tag}"
                Height="64"
                Padding="0"
                Margin="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                PointerEntered="ShortcutButton_PointerEntered"
                PointerExited="ShortcutButton_PointerExited"
                PointerPressed="ShortcutButton_PointerPressed"
                PointerReleased="ShortcutButton_PointerReleased"
                Click="ShortcutButton_Click">
                <Border
                    x:Name="ShortcutHoverRoot"
                    Width="{Binding ElementName=ShortcutGridView, Path=Tag}"
                    Height="64"
                    Padding="4,2"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Background="#16FFFFFF"
                            CornerRadius="14">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                Glyph="{x:Bind Glyph}"
                                FontSize="13"
                                Foreground="{StaticResource ShellPrimaryTextBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                Foreground="{StaticResource ShellPrimaryTextBrush}"
                                FontSize="{StaticResource DiscoveryShortcutTitleFontSize}"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryShortcutDescriptionFontSize}"
                                MaxLines="1"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DiscoveryTodayTemplate" x:DataType="local:HomeSubjectItem">
            <Button
                Style="{StaticResource FlatActionButtonStyle}"
                Padding="0"
                Margin="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                PointerEntered="CardButton_PointerEntered"
                PointerExited="CardButton_PointerExited"
                PointerPressed="CardButton_PointerPressed"
                PointerReleased="CardButton_PointerReleased"
                Click="SubjectCardButton_Click">
                <Grid Width="176" Height="330">
                    <Border
                        x:Name="CardShadow"
                        Width="176"
                        Height="4"
                        Margin="0,0,0,0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Background="{StaticResource ShellAccentBrush}"/>

                    <Border
                        x:Name="CardSurface"
                        Width="176"
                        Height="322"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource ShellSurfaceBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CardTranslateTransform"/>
                        </Border.RenderTransform>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="196"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="CardHoverTint"
                            Grid.RowSpan="6"
                            Background="#18FFFFFF"
                            Opacity="0"
                            IsHitTestVisible="False"/>

                        <Border
                            x:Name="CardHoverGlow"
                            Grid.RowSpan="6"
                            Opacity="0"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                    <GradientStop Offset="0" Color="#3CFFFFFF"/>
                                    <GradientStop Offset="0.32" Color="#18FFFFFF"/>
                                    <GradientStop Offset="0.72" Color="#08FFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <controls:ImageEx
                            Grid.Row="0"
                            Width="176"
                            Height="196"
                            Source="{x:Bind Cover}"
                            PlaceholderSource="{x:Bind common:Constants.NotFoundImgUri}"
                            PlaceholderStretch="UniformToFill"
                            Stretch="UniformToFill"
                            IsCacheEnabled="True"
                            CacheMode="BitmapCache"/>

                        <bangumiControls:MarqueeTextBlock
                            Grid.Row="1"
                            Margin="10,10,10,0"
                            Height="22"
                            HorizontalAlignment="Stretch"
                            TextForeground="{StaticResource ShellPrimaryTextBrush}"
                            TextFontSize="{StaticResource DiscoveryCardTitleFontSize}"
                            TextFontWeight="SemiBold"
                            Text="{x:Bind Title}"/>

                        <TextBlock
                            Grid.Row="2"
                            Margin="10,4,10,0"
                            Visibility="{x:Bind SubtitleVisibility}"
                            Foreground="{StaticResource ShellSecondaryTextBrush}"
                            FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                            Text="{x:Bind Subtitle}"
                            TextTrimming="CharacterEllipsis"/>

                        <TextBlock
                            Grid.Row="3"
                            Margin="10,8,10,0"
                            Foreground="{x:Bind TypeBrush}"
                            FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                            Text="{x:Bind TypeText}"
                            TextTrimming="CharacterEllipsis"/>

                        <TextBlock
                            Grid.Row="4"
                            Margin="10,4,10,0"
                            Visibility="{x:Bind CollectionVisibility}"
                            Foreground="{StaticResource ShellSecondaryTextBrush}"
                            FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                            Text="{x:Bind CollectionText}"
                            TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Row="5" Margin="10,6,10,10" Spacing="3">
                            <TextBlock
                                Visibility="{x:Bind RatingVisibility}"
                                Foreground="{StaticResource ShellPrimaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                Text="{x:Bind RatingText}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Visibility="{x:Bind RankVisibility}"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                Text="{x:Bind RankText}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Visibility="Collapsed"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                Text="{x:Bind StatusText}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border
                            x:Name="CollectionStatusBadge"
                            Grid.Row="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="10,6,10,10"
                            Padding="8,3"
                            Background="{x:Bind CollectionStatusBrush}"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1"
                            Visibility="{x:Bind CollectionStatusVisibility}"
                            IsTapEnabled="True"
                            Tapped="CollectionStatusBadge_Tapped"
                            PointerPressed="CollectionStatusBadge_PointerPressed"
                            PointerReleased="CollectionStatusBadge_PointerReleased">
                            <TextBlock
                                Foreground="White"
                                FontSize="{StaticResource DiscoveryCollectionStatusFontSize}"
                                FontWeight="Normal"
                                Text="{x:Bind CollectionStatusText}"/>
                        </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DiscoveryFeaturedTemplate" x:DataType="local:HomeSubjectItem">
            <Button
                Style="{StaticResource FlatActionButtonStyle}"
                Padding="0"
                Margin="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                PointerEntered="CardButton_PointerEntered"
                PointerExited="CardButton_PointerExited"
                PointerPressed="CardButton_PointerPressed"
                PointerReleased="CardButton_PointerReleased"
                Click="SubjectCardButton_Click">
                <Grid
                    Width="{Binding ElementName=PageRoot, Path=Tag}"
                    Height="160"
                    Margin="0,0,12,8">
                    <Border
                        x:Name="CardShadow"
                        Width="{Binding ElementName=PageRoot, Path=Tag}"
                        Height="4"
                        Margin="0,0,0,0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Background="{StaticResource ShellAccentBrush}"/>

                    <Border
                    x:Name="CardSurface"
                    Width="{Binding ElementName=PageRoot, Path=Tag}"
                    Height="152"
                    VerticalAlignment="Bottom"
                    Padding="0"
                    Background="{StaticResource ShellSurfaceBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CardTranslateTransform"/>
                        </Border.RenderTransform>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="88"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="CardHoverTint"
                            Grid.ColumnSpan="3"
                            Background="#18FFFFFF"
                            Opacity="0"
                            IsHitTestVisible="False"/>

                        <Border
                            x:Name="CardHoverGlow"
                            Grid.ColumnSpan="3"
                            Opacity="0"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                    <GradientStop Offset="0" Color="#42FFFFFF"/>
                                    <GradientStop Offset="0.35" Color="#1CFFFFFF"/>
                                    <GradientStop Offset="0.74" Color="#08FFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <controls:ImageEx
                            Width="92"
                            Height="152"
                            Source="{x:Bind Cover}"
                            PlaceholderSource="{x:Bind common:Constants.NotFoundImgUri}"
                            PlaceholderStretch="UniformToFill"
                            Stretch="UniformToFill"
                            IsCacheEnabled="True"
                            CacheMode="BitmapCache"/>

                        <StackPanel Grid.Column="1" Padding="12,12,10,12" Spacing="4">
                            <bangumiControls:MarqueeTextBlock
                                Height="26"
                                HorizontalAlignment="Stretch"
                                TextForeground="{StaticResource ShellPrimaryTextBrush}"
                                TextFontSize="{StaticResource DiscoveryCardTitleFontSize}"
                                TextFontWeight="SemiBold"
                                Text="{x:Bind Title}"/>
                            <TextBlock
                                Visibility="{x:Bind SubtitleVisibility}"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                MaxLines="1"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Foreground="{x:Bind TypeBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                MaxLines="1"
                                Text="{x:Bind TypeText}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Visibility="{x:Bind WeekdayVisibility}"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                MaxLines="1"
                                Text="{x:Bind WeekdayText}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Visibility="{x:Bind CollectionVisibility}"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                MaxLines="1"
                                Text="{x:Bind CollectionText}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Visibility="{x:Bind MetaVisibility}"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                MaxLines="1"
                                Text="{x:Bind Meta}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Visibility="Collapsed"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                MaxLines="1"
                                Text="{x:Bind StatusText}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Padding="0,12,10,12" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock
                                Visibility="{x:Bind RatingVisibility}"
                                Foreground="{StaticResource ShellPrimaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                MaxLines="1"
                                Text="{x:Bind RatingText}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Visibility="{x:Bind RankVisibility}"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="{StaticResource DiscoveryCardBodyFontSize}"
                                HorizontalAlignment="Right"
                                MaxLines="1"
                                Text="{x:Bind RankText}"/>
                        </StackPanel>

                        <Border
                            x:Name="CollectionStatusBadge"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,10,10"
                            Padding="8,3"
                            Background="{x:Bind CollectionStatusBrush}"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1"
                            Visibility="{x:Bind CollectionStatusVisibility}"
                            IsTapEnabled="True"
                            Tapped="CollectionStatusBadge_Tapped"
                            PointerPressed="CollectionStatusBadge_PointerPressed"
                            PointerReleased="CollectionStatusBadge_PointerReleased">
                            <TextBlock
                                Foreground="White"
                                FontSize="{StaticResource DiscoveryCollectionStatusFontSize}"
                                FontWeight="Normal"
                                Text="{x:Bind CollectionStatusText}"/>
                        </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot" Tag="{x:Bind FeaturedCardWidth, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ProgressBar
            Grid.Row="0"
            Height="3"
            IsIndeterminate="True"
            Visibility="{x:Bind IsLoading, Mode=OneWay}"/>

        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="MainScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="MainScrollViewer_ViewChanged">
                <StackPanel x:Name="ContentPanel" Padding="0,0,0,24" Spacing="0" SizeChanged="ContentPanel_SizeChanged">
                    <GridView
                        x:Name="ShortcutGridView"
                        Tag="{x:Bind ShortcutCardWidth, Mode=OneWay}"
                        Height="{x:Bind ShortcutGridHeight, Mode=OneWay}"
                        Margin="0,0,0,18"
                        Padding="0"
                        IsItemClickEnabled="False"
                        IsSwipeEnabled="False"
                        ItemsSource="{x:Bind Shortcuts, Mode=OneWay}"
                        ItemTemplate="{StaticResource DiscoveryShortcutTemplate}"
                        ItemContainerStyle="{StaticResource ShortcutItemStyle}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.IsVerticalScrollChainingEnabled="False">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid x:Name="ShortcutWrapGrid" Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>

                    <StackPanel x:Name="TodaySection" Margin="0,0,0,28">
                        <Grid x:Name="TodayHeaderAnchor" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Style="{StaticResource SectionHeaderTextStyle}"
                                Text="{x:Bind TodayHeaderTitle, Mode=OneWay}"/>

                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                Foreground="{StaticResource ShellSecondaryTextBrush}"
                                FontSize="12"
                                VerticalAlignment="Bottom"
                                Text="{x:Bind TodaySummary, Mode=OneWay}"/>

                            <Border
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Width="42"
                                Height="3"
                                HorizontalAlignment="Left"
                                Background="{StaticResource ShellAccentBrush}"/>
                        </Grid>

                        <Grid Margin="0">
                            <ScrollViewer
                                x:Name="TodayItemsScrollViewer"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                ViewChanged="TodayItemsScrollViewer_ViewChanged">
                                <ItemsControl ItemsSource="{x:Bind TodaySubjects, Mode=OneWay}" ItemTemplate="{StaticResource DiscoveryTodayTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <controls:DropShadowPanel
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10,80,0,0"
                                BlurRadius="24"
                                Color="#C0000000"
                                OffsetX="0"
                                OffsetY="12"
                                Opacity="0.6">
                                <Button
                                    x:Name="TodayScrollLeftButton"
                                    Width="36"
                                    Height="36"
                                    Click="TodayScrollLeftButton_Click"
                                    Visibility="{x:Bind TodayLeftButtonVisibility, Mode=OneWay}"
                                    Style="{StaticResource CircleNavButtonStyle}">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76B;" FontSize="14" Foreground="{StaticResource ShellPrimaryTextBrush}"/>
                                </Button>
                            </controls:DropShadowPanel>

                            <controls:DropShadowPanel
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,80,10,0"
                                BlurRadius="24"
                                Color="#C0000000"
                                OffsetX="0"
                                OffsetY="12"
                                Opacity="0.6">
                                <Button
                                    x:Name="TodayScrollRightButton"
                                    Width="36"
                                    Height="36"
                                    Click="TodayScrollRightButton_Click"
                                    Visibility="{x:Bind TodayRightButtonVisibility, Mode=OneWay}"
                                    Style="{StaticResource CircleNavButtonStyle}">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="14" Foreground="{StaticResource ShellPrimaryTextBrush}"/>
                                </Button>
                            </controls:DropShadowPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="FeaturedSection" Margin="0,0,0,8">
                        <Grid x:Name="FeaturedHeaderAnchor" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Style="{StaticResource SectionHeaderTextStyle}"
                                Text="放送列表"/>

                            <Border
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Width="56"
                                Height="3"
                                HorizontalAlignment="Left"
                                Background="{StaticResource ShellAccentBrush}"/>
                        </Grid>

                        <GridView
                            x:Name="FeaturedGridView"
                            Height="{x:Bind FeaturedGridHeight, Mode=OneWay}"
                            Padding="0"
                            IsItemClickEnabled="False"
                            IsSwipeEnabled="False"
                            ItemsSource="{x:Bind FeaturedSubjects, Mode=OneWay}"
                            ItemTemplate="{StaticResource DiscoveryFeaturedTemplate}"
                            ItemContainerStyle="{StaticResource FeaturedItemStyle}"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.IsVerticalScrollChainingEnabled="False">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid x:Name="FeaturedWrapGrid" Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}">
                        <Image
                            Width="220"
                            Height="220"
                            Source="{x:Bind common:Constants.EmptyImgUri}"
                            Stretch="Uniform"/>
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource ShellSecondaryTextBrush}"
                            Text="暂无发现内容"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border
                x:Name="StickySectionHeader"
                Height="34"
                VerticalAlignment="Top"
                Background="Transparent"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="StickySectionTransform"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="StickySectionHeaderText"
                        Style="{StaticResource SectionHeaderTextStyle}"
                        Text=""/>
                    <Border
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Width="42"
                        Height="3"
                        HorizontalAlignment="Left"
                        Background="{StaticResource ShellAccentBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
